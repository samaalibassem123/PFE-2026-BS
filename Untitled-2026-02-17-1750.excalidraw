      "type": "text",
      "x": -10151.70101906275,
      "y": 5909.006162646082,
      "width": 1525.432861328125,
      "height": 859.0705865415273,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
