      "link": null,
      "locked": false,
      "text": "don't forget to call\nevery table with his\ndb name ex:\nbiotitme123.person\nnel_employee",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sPp5YGM9ueO10vfrjJK7q",
      "originalText": "don't forget to call every table with his db name ex:\nbiotitme123.personnel_employee",
