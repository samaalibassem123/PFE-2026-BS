    {
      "id": "lT1M6xT9jimBN3n5QaOuK",
      "type": "text",
      "x": 1088.632287954207,
      "y": 2377.9782066835014,
      "width": 568.6874389648438,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f08c00",
