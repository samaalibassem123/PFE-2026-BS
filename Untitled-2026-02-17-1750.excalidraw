      "versionNonce": 2050810935,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774456554527,
      "link": null,
      "locked": false,
      "text": "    //CREATE VIEW View_Employee AS\n    SELECT EP.emp_fullname , EP.email  , B.department_id  \n    FROM easy_employee_view EP\n    INNER JOIN personnel_employee B \n    ON B.email = EP.email \n    OR\n    B.first_name = EP.emp_fullname\n\n    or if u going to use sqlAlchemy just a create a view for biotime to be\neasier for u\nCREATE VIEW biotime_employee_view AS\nSELECT \n        emp.id AS ep_emp_id,\n        emp.first_name AS emp_fullname,\n        emp.emp_code ,\n        emp.email,\n        emp.department_id,\n        emp.hire_date\nFROM personnel_employee AS emp\n    \n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "DJwR26lmBSNuq0YDJUXhs",
      "originalText": "    //CREATE VIEW View_Employee AS\n    SELECT EP.emp_fullname , EP.email  , B.department_id  \n    FROM easy_employee_view EP\n    INNER JOIN personnel_employee B \n    ON B.email = EP.email \n    OR\n    B.first_name = EP.emp_fullname\n\n    or if u going to use sqlAlchemy just a create a view for biotime to be easier for u\nCREATE VIEW biotime_employee_view AS\nSELECT \n        emp.id AS ep_emp_id,\n        emp.first_name AS emp_fullname,\n        emp.emp_code ,\n        emp.email,\n        emp.department_id,\n        emp.hire_date\nFROM personnel_employee AS emp\n    \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
