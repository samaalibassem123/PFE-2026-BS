      "seed": 799097322,
      "version": 590,
      "versionNonce": 410157175,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771675877046,
      "link": null,
      "locked": false,
      "text": "Step1 :\n    Fill department table :\n            * Use personnel_department from biotime\n\n\n\n\n\n\n\n\n\n\n\n\nstep 2 :\n    fill the employees table from easy_employee_view only and for each employee get\n    his depratment id from BIOTIME_EMPLOYEE_VIEW search by email or by fullname\n    because sometime there is no email for the employees on biotime",
      "fontSize": 36.17139311753799,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step1 :\n    Fill department table :\n            * Use personnel_department from biotime\n\n\n\n\n\n\n\n\n\n\n\n\nstep 2 :\n    fill the employees table from easy_employee_view only and for each employee get\n    his depratment id from BIOTIME_EMPLOYEE_VIEW search by email or by fullname\n    because sometime there is no email for the employees on biotime",
      "autoResize": true,
      "lineHeight": 1.25
    },
