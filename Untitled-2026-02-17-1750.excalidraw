      "version": 253,
      "versionNonce": 959444695,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774456554527,
      "link": null,
      "locked": false,
      "text": "to fill the leave table we just add the values from both \neay_attendance_view and biotime_att_leave_view\nbecause sometimes the leave is justified on the easy project\nbut not on biotime and the same for oposite",
      "fontSize": 20,
