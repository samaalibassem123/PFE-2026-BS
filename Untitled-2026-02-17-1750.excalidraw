      "isDeleted": false,
      "boundElements": [],
      "updated": 1774456554527,
      "link": null,
      "locked": false,
      "text": "    //CREATE VIEW easy_employee_view AS\n    SELECT \n        u.id AS ep_emp_id,\n        CONCAT(u.firstname, ' ', u.lastname) AS emp_fullname,\n        e.address as email\n    FROM users AS u\n    INNER JOIN email_addresses AS e\n        ON e.user_id = u.id;\n    ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "VStjlbjpAQ7sfx_UNX9vX",
      "originalText": "    //CREATE VIEW easy_employee_view AS\n    SELECT \n        u.id AS ep_emp_id,\n        CONCAT(u.firstname, ' ', u.lastname) AS emp_fullname,\n        e.address as email\n    FROM users AS u\n    INNER JOIN email_addresses AS e\n        ON e.user_id = u.id;\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
