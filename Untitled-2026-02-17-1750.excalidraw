    {
      "id": "3wCLlEJCRyuVd6qHmd_ip",
      "type": "text",
      "x": 1089.7684659440672,
      "y": 2118.300936330868,
      "width": 467.13555908203125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f08c00",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
